{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wealthplans",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_ENV": "local"
  },
  // These names and IDs are intentionally local-only. `vite` and `wrangler dev`
  // use local D1/R2 state unless a binding explicitly opts into `remote: true`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wealthplans-local",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "wealthplans-local-files"
    }
  ]
}
